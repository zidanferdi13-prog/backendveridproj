# Server Port
PORT=3000

# Database Configuration (MySQL/MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=veridface

# Railway MySQL Service Variables (Auto-filled if using Railway MySQL)
MYSQLHOST=containers-us-west-123.railway.app
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=containers-us-west-123.railway.app
MYSQLDATABASE=veridface

# MQTT Configuration
MQTT_BROKER_URL=mqtt://broker.example.com:1883
MQTT_USERNAME=mqtt_user
MQTT_PASSWORD=mqtt_password

# Optional: MQTT with SSL/TLS
# MQTT_BROKER_URL=mqtts://broker.example.com:8883

# Logging
LOG_LEVEL=info
